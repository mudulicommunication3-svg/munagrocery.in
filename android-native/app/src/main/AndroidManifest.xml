<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core WebView networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 3 KM Leaflet delivery-radius map (geolocation) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Camera for the barcode/QR scanner -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- New-order notification alert/vibration -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    // Persistent foreground service: keeps the WebView process alive while the
    // app is backgrounded (auto-restarts unless the user force-stops), so the
    // 15 s AlarmManager poller keeps catching live orders like WhatsApp.
    // No visible notification (START_NOT_STICKY + no notify) — silent keep-alive.
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MunnaGrocery">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MunnaGrocery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified App Links: tapping https://munagrocery.in anywhere
                 (WhatsApp, browser, Telegram) opens THIS app instead of Chrome.
                 Verified against /.well-known/assetlinks.json, which already
                 carries this APK's signing-cert SHA-256 fingerprint. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="munagrocery.in" />
            </intent-filter>
        </activity>

        <!-- FileProvider: ShareBridge product photo -> WhatsApp/Facebook/Gmail -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="in.munagrocery.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Background live-order poll (AlarmManager -> 15 s GET_UNSEEN_ORDERS).
             Not exported; only this app's own PendingIntents can fire it. -->
        <receiver
            android:name=".BackgroundOrderPollReceiver"
            android:exported="false" />

        <!-- Keep-alive: silent foreground service so Android does not kill the
             WebView process while backgrounded (auto-restarts on kill unless
             force-stopped). No visible notification is posted. -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Re-arm the 15 s poll after a device reboot (alarms are cleared). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
