# ---------------------------------------------------------------------------
# MUNNA MOBILE & Grocery — backend configuration
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. (The code also accepts the legacy name BOT_TOKEN.)
TELEGRAM_TOKEN=

# --- Google Sheets database -------------------------------------------------
# Path to the Google service-account JSON key file, relative to the project
# root or absolute, e.g. GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_CREDENTIALS_FILE=

# Optional sheet targeting (defaults shown). Prefer an ID over a title.
# IMPORTANT: share the spreadsheet with the service-account email address.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME="MUNNA MOBILE & Grocery"
GOOGLE_SHEET_WORKSHEET=Sheet1

# Auth backend: auto (default: oauth2client first, google-auth fallback)
# | oauth2client | service_account
GOOGLE_SHEETS_AUTH=auto

# --- Google Custom Search (product images) ----------------------------------
# JSON API key + Programmable Search Engine ID with "Image search" enabled.
CUSTOM_SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- Google Gemini (AI customer assistant) ----------------------------------
GEMINI_API_KEY=

# --- Admin bot --------------------------------------------------------------
# Telegram user ID allowed to use the admin features.
# If empty or 0, every user can open the Admin Panel (dev mode).
ADMIN_ID=

# --- Web Admin login (webapp Admin Panel, 10 digits each) ---------------------
# Template only — copy these two lines into shopbot/.env (git-ignored) and set
# your real values there. Never hardcode the credentials in HTML/JS.
# Mirror the same two values into the Apps Script project as Script Properties
# (Project Settings -> Script Properties: ADMIN_USERNAME / ADMIN_PASSWORD)
# AND/OR into the Sheet Config tab keys ADMIN_USERNAME / ADMIN_PASSWORD.
# Lookup order inside googlesheetwebapp.js:
#   Script Properties -> Config tab -> built-in default 1111111111.
ADMIN_USERNAME=1111111111
ADMIN_PASSWORD=1111111111

# --- Mini App (Telegram Web App store) --------------------------------------
# Public HTTPS URL of webapp/shop.html (e.g. GitHub Pages / Netlify / Vercel).
# When empty, /start shows only "Browse Store" (no "Open Shop" button).
WEB_APP_URL=

# --- Webapp <-> bot order sync (web_sync.py) -------------------------------
# The Netlify webapp and this bot share ONE Google Sheet Orders tab
# (13-column unified format, see db.ORDERS_HEADERS). The bot polls it for
# browser orders (channel "webapp"): admin alert + live customer status
# message + status-change edits. All optional - sensible defaults apply.
# WEB_SYNC_INTERVAL=30        # seconds between polls
# WEB_SYNC_FIRST_DELAY=15     # wait after startup before the first poll
# WEB_SYNC_STATE_FILE=        # alert/state JSON (default: .web_sync_state.json)
